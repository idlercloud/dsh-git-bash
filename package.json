{
  "name": "@idlercloud/dsh-git-bash",
  "version": "0.2.0",
  "description": "Git for Windows bash tool for DSH on Windows; fork of Fishquito7/dsh-gitbash.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.2-rc.1": "compatible"
      }
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "test",
    "README.md",
    "README.en.md"
  ],
  "engines": {
    "node": "^22.19 || >=24",
    "dsh": ">=0.2.2-rc.1 <0.2.3-0"
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "check:fix": "biome check --write ."
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/idlercloud/dsh-git-bash.git"
  },
  "homepage": "https://github.com/idlercloud/dsh-git-bash#readme",
  "bugs": {
    "url": "https://github.com/idlercloud/dsh-git-bash/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "bash",
    "git-bash",
    "windows"
  ],
  "devDependencies": {
    "@biomejs/biome": "2.6.6"
  }
}
